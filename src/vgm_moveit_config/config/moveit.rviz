Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: moveit_rviz_plugin/MotionPlanning
    Name: Motion Planning
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Grid
      Plane: XY
    - Class: moveit_rviz_plugin/MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Name: MotionPlanning
      Planning Group: manipulator
      Planning Request:
        Planning Time: 5
        Planning Attempts: 10
        Velocity Scaling Factor: 0.35
        Acceleration Scaling Factor: 0.35
      Scene Robot:
        Robot Alpha: 1.0
      Scene Geometry:
        Scene Alpha: 0.9
      Trajectory Topic: /display_planned_path
  Enabled: true
  Global Options:
    Background Color: 28; 31; 36
    Fixed Frame: world
    Frame Rate: 30
  Name: root
Window Geometry:
  Height: 900
  Width: 1440
