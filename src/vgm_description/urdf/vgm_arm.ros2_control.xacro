<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="vgm_ros2_control" params="prefix use_gazebo">
    <ros2_control name="${prefix}VgmSystem" type="system">
      <hardware>
        <xacro:if value="${use_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_gazebo}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:unless>
      </hardware>

      <xacro:macro name="arm_control_joint" params="name lower upper velocity effort">
        <joint name="${prefix}${name}">
          <command_interface name="position">
            <param name="min">${lower}</param>
            <param name="max">${upper}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <param name="initial_position">0.0</param>
        </joint>
      </xacro:macro>

      <xacro:arm_control_joint name="joint_1" lower="${-pi}" upper="${pi}" velocity="1.5" effort="90"/>
      <xacro:arm_control_joint name="joint_2" lower="-2.20" upper="2.20" velocity="1.4" effort="90"/>
      <xacro:arm_control_joint name="joint_3" lower="-2.60" upper="2.60" velocity="1.6" effort="70"/>
      <xacro:arm_control_joint name="joint_4" lower="${-pi}" upper="${pi}" velocity="2.0" effort="35"/>
      <xacro:arm_control_joint name="joint_5" lower="-2.20" upper="2.20" velocity="2.0" effort="30"/>
      <xacro:arm_control_joint name="joint_6" lower="${-pi}" upper="${pi}" velocity="2.5" effort="20"/>

      <joint name="${prefix}left_finger_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.04</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="initial_position">0.02</param>
      </joint>
    </ros2_control>

    <xacro:if value="${use_gazebo}">
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find vgm_description)/config/ros2_controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
