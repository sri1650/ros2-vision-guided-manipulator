<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vgm_arm">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_gazebo" default="false"/>

  <xacro:include filename="$(find vgm_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find vgm_description)/urdf/inertials.xacro"/>
  <xacro:include filename="$(find vgm_description)/urdf/vgm_arm.ros2_control.xacro"/>

  <xacro:property name="pi" value="3.141592653589793"/>
  <xacro:property name="arm_prefix" value="$(arg prefix)"/>

  <!-- Base and shoulder: primitive geometry keeps the model portable and CI-friendly. -->
  <link name="${arm_prefix}base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
      <material name="vgm_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.12" length="0.08"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="5.0" radius="0.12" length="0.08" origin_xyz="0 0 0.04"/>
  </link>

  <link name="${arm_prefix}shoulder_link">
    <visual>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><box size="0.11 0.13 0.18"/></geometry>
      <material name="vgm_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry><box size="0.11 0.13 0.18"/></geometry>
    </collision>
    <xacro:box_inertial mass="3.2" x="0.11" y="0.13" z="0.18" origin_xyz="0 0 0.09"/>
  </link>
  <joint name="${arm_prefix}joint_1" type="revolute">
    <parent link="${arm_prefix}base_link"/>
    <child link="${arm_prefix}shoulder_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="90" velocity="1.5"/>
    <dynamics damping="0.12" friction="0.04"/>
  </joint>

  <link name="${arm_prefix}upper_arm_link">
    <visual>
      <origin xyz="0.16 0 0" rpy="0 0 0"/>
      <geometry><box size="0.32 0.09 0.10"/></geometry>
      <material name="vgm_blue"/>
    </visual>
    <collision>
      <origin xyz="0.16 0 0" rpy="0 0 0"/>
      <geometry><box size="0.32 0.09 0.10"/></geometry>
    </collision>
    <xacro:box_inertial mass="3.0" x="0.32" y="0.09" z="0.10" origin_xyz="0.16 0 0"/>
  </link>
  <joint name="${arm_prefix}joint_2" type="revolute">
    <parent link="${arm_prefix}shoulder_link"/>
    <child link="${arm_prefix}upper_arm_link"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.20" upper="2.20" effort="90" velocity="1.4"/>
    <dynamics damping="0.12" friction="0.04"/>
  </joint>

  <link name="${arm_prefix}forearm_link">
    <visual>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <geometry><box size="0.28 0.075 0.085"/></geometry>
      <material name="vgm_silver"/>
    </visual>
    <collision>
      <origin xyz="0.14 0 0" rpy="0 0 0"/>
      <geometry><box size="0.28 0.075 0.085"/></geometry>
    </collision>
    <xacro:box_inertial mass="2.1" x="0.28" y="0.075" z="0.085" origin_xyz="0.14 0 0"/>
  </link>
  <joint name="${arm_prefix}joint_3" type="revolute">
    <parent link="${arm_prefix}upper_arm_link"/>
    <child link="${arm_prefix}forearm_link"/>
    <origin xyz="0.32 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.60" upper="2.60" effort="70" velocity="1.6"/>
    <dynamics damping="0.10" friction="0.03"/>
  </joint>

  <link name="${arm_prefix}wrist_1_link">
    <visual>
      <origin xyz="0.05 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.055" length="0.10"/></geometry>
      <material name="vgm_dark"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.055" length="0.10"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.85" radius="0.055" length="0.10" origin_xyz="0.05 0 0" origin_rpy="0 1.57079632679 0"/>
  </link>
  <joint name="${arm_prefix}joint_4" type="revolute">
    <parent link="${arm_prefix}forearm_link"/>
    <child link="${arm_prefix}wrist_1_link"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-pi}" upper="${pi}" effort="35" velocity="2.0"/>
    <dynamics damping="0.08" friction="0.02"/>
  </joint>

  <link name="${arm_prefix}wrist_2_link">
    <visual>
      <origin xyz="0.04 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.047" length="0.08"/></geometry>
      <material name="vgm_blue"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.047" length="0.08"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.60" radius="0.047" length="0.08" origin_xyz="0.04 0 0" origin_rpy="0 1.57079632679 0"/>
  </link>
  <joint name="${arm_prefix}joint_5" type="revolute">
    <parent link="${arm_prefix}wrist_1_link"/>
    <child link="${arm_prefix}wrist_2_link"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.20" upper="2.20" effort="30" velocity="2.0"/>
    <dynamics damping="0.08" friction="0.02"/>
  </joint>

  <link name="${arm_prefix}wrist_3_link">
    <visual>
      <origin xyz="0.035 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.043" length="0.07"/></geometry>
      <material name="vgm_dark"/>
    </visual>
    <collision>
      <origin xyz="0.035 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.043" length="0.07"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.42" radius="0.043" length="0.07" origin_xyz="0.035 0 0" origin_rpy="0 1.57079632679 0"/>
  </link>
  <joint name="${arm_prefix}joint_6" type="revolute">
    <parent link="${arm_prefix}wrist_2_link"/>
    <child link="${arm_prefix}wrist_3_link"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-pi}" upper="${pi}" effort="20" velocity="2.5"/>
    <dynamics damping="0.06" friction="0.02"/>
  </joint>

  <link name="${arm_prefix}tool0"/>
  <joint name="${arm_prefix}tool0_joint" type="fixed">
    <parent link="${arm_prefix}wrist_3_link"/>
    <child link="${arm_prefix}tool0"/>
    <origin xyz="0.07 0 0" rpy="0 0 0"/>
  </joint>

  <link name="${arm_prefix}gripper_base_link">
    <visual>
      <origin xyz="0.025 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.12 0.07"/></geometry>
      <material name="vgm_orange"/>
    </visual>
    <collision>
      <origin xyz="0.025 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.12 0.07"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.40" x="0.05" y="0.12" z="0.07" origin_xyz="0.025 0 0"/>
  </link>
  <joint name="${arm_prefix}gripper_mount_joint" type="fixed">
    <parent link="${arm_prefix}tool0"/>
    <child link="${arm_prefix}gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="finger_link" params="name y_sign">
    <link name="${arm_prefix}${name}">
      <visual>
        <origin xyz="0.07 0 0" rpy="0 0 0"/>
        <geometry><box size="0.14 0.016 0.035"/></geometry>
        <material name="vgm_dark"/>
      </visual>
      <collision>
        <origin xyz="0.07 0 0" rpy="0 0 0"/>
        <geometry><box size="0.14 0.016 0.035"/></geometry>
      </collision>
      <xacro:box_inertial mass="0.09" x="0.14" y="0.016" z="0.035" origin_xyz="0.07 0 0"/>
    </link>
  </xacro:macro>
  <xacro:finger_link name="left_finger_link" y_sign="1"/>
  <xacro:finger_link name="right_finger_link" y_sign="-1"/>

  <joint name="${arm_prefix}left_finger_joint" type="prismatic">
    <parent link="${arm_prefix}gripper_base_link"/>
    <child link="${arm_prefix}left_finger_link"/>
    <origin xyz="0.04 0.026 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="40" velocity="0.05"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>
  <joint name="${arm_prefix}right_finger_joint" type="prismatic">
    <parent link="${arm_prefix}gripper_base_link"/>
    <child link="${arm_prefix}right_finger_link"/>
    <origin xyz="0.04 -0.026 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.04" effort="40" velocity="0.05"/>
    <mimic joint="${arm_prefix}left_finger_joint" multiplier="1.0" offset="0.0"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="${arm_prefix}tcp_link"/>
  <joint name="${arm_prefix}tcp_joint" type="fixed">
    <parent link="${arm_prefix}gripper_base_link"/>
    <child link="${arm_prefix}tcp_link"/>
    <origin xyz="0.17 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Eye-to-hand RGB-D camera: link X points down; optical frames follow REP-103. -->
  <link name="${arm_prefix}camera_mast_link">
    <visual>
      <origin xyz="0 0 0.60" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 1.20"/></geometry>
      <material name="vgm_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.60" rpy="0 0 0"/>
      <geometry><box size="0.045 0.045 1.20"/></geometry>
    </collision>
    <xacro:box_inertial mass="1.4" x="0.045" y="0.045" z="1.20" origin_xyz="0 0 0.60"/>
  </link>
  <joint name="${arm_prefix}camera_mast_joint" type="fixed">
    <parent link="${arm_prefix}base_link"/>
    <child link="${arm_prefix}camera_mast_link"/>
    <origin xyz="-0.22 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="${arm_prefix}camera_boom_link">
    <visual>
      <origin xyz="0.30 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.045 0.045"/></geometry>
      <material name="vgm_silver"/>
    </visual>
    <collision>
      <origin xyz="0.30 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.045 0.045"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.65" x="0.60" y="0.045" z="0.045" origin_xyz="0.30 0 0"/>
  </link>
  <joint name="${arm_prefix}camera_boom_joint" type="fixed">
    <parent link="${arm_prefix}camera_mast_link"/>
    <child link="${arm_prefix}camera_boom_link"/>
    <origin xyz="0 0 1.19" rpy="0 0 0"/>
  </joint>

  <link name="${arm_prefix}camera_link">
    <visual>
      <geometry><box size="0.085 0.13 0.045"/></geometry>
      <material name="vgm_dark"/>
    </visual>
    <collision>
      <geometry><box size="0.085 0.13 0.045"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.28" x="0.085" y="0.13" z="0.045"/>
  </link>
  <joint name="${arm_prefix}camera_mount_joint" type="fixed">
    <parent link="${arm_prefix}camera_boom_link"/>
    <child link="${arm_prefix}camera_link"/>
    <origin xyz="0.60 0 0" rpy="0 1.57079632679 0"/>
  </joint>

  <link name="${arm_prefix}camera_color_frame"/>
  <joint name="${arm_prefix}camera_color_joint" type="fixed">
    <parent link="${arm_prefix}camera_link"/>
    <child link="${arm_prefix}camera_color_frame"/>
    <origin xyz="0.025 -0.025 0" rpy="0 0 0"/>
  </joint>
  <link name="${arm_prefix}camera_color_optical_frame"/>
  <joint name="${arm_prefix}camera_color_optical_joint" type="fixed">
    <parent link="${arm_prefix}camera_color_frame"/>
    <child link="${arm_prefix}camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="${arm_prefix}camera_depth_frame"/>
  <joint name="${arm_prefix}camera_depth_joint" type="fixed">
    <parent link="${arm_prefix}camera_link"/>
    <child link="${arm_prefix}camera_depth_frame"/>
    <origin xyz="0.025 0.025 0" rpy="0 0 0"/>
  </joint>
  <link name="${arm_prefix}camera_depth_optical_frame"/>
  <joint name="${arm_prefix}camera_depth_optical_joint" type="fixed">
    <parent link="${arm_prefix}camera_depth_frame"/>
    <child link="${arm_prefix}camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <gazebo reference="${arm_prefix}camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/camera</topic>
      <gz_frame_id>${arm_prefix}camera_depth_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.15</near>
          <far>3.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.15</near>
            <far>3.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <xacro:vgm_ros2_control prefix="${arm_prefix}" use_gazebo="$(arg use_gazebo)"/>
</robot>
