{
  "name": "ROS 2 Vision-Guided Manipulator",
  "build": {"dockerfile": "../Dockerfile", "context": ".."},
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "runArgs": ["--network=host"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "remoteUser": "root"
}

